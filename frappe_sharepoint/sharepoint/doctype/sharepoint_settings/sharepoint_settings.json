  {
   "depends_on": "eval: doc.enable_file_sync == 1",
   "fieldname": "excluded_doctypes",
   "fieldtype": "Table",
   "label": "Excluded Document Types",
   "options": "SharePoint Excluded DocType",
   "description": "Attachments of these document types stay on the Frappe server and are not sent to SharePoint. Add any document type whose files your apps read back from the server, e.g. custom import tools or templates. Data Import, Bank Statement Import, Prepared Report, Letter Head, Package Import, Repost Item Valuation, Import Supplier Invoice and User Font are always excluded."
  },
  {
   "depends_on": "eval: doc.enable_file_sync == 1 && doc.folder_structure != 'Flat'",
   "fieldname": "folder_mapping_section",
   "fieldtype": "Section Break",
   "label": "Folder Mapping",
   "description": "Optional. Folders are created in SharePoint automatically, you only choose their names. Use SharePoint > Load Default Mappings for a starting point."
  },
  {
   "depends_on": "eval: doc.enable_file_sync == 1 && doc.folder_structure == 'Company/Module/DocType/Document'",
   "fieldname": "company_folders",
   "fieldtype": "Table",
   "label": "Company Folders",
   "options": "SharePoint Company Folder",
   "description": "Name of the top-level folder for each company, e.g., PEAS Uganda. Companies not listed here use the company name."
  },
  {
   "depends_on": "eval: doc.enable_file_sync == 1 && doc.folder_structure == 'Company/Module/DocType/Document'",
   "fieldname": "default_company_folder",
   "fieldtype": "Data",
   "label": "Folder for Documents without a Company",
   "description": "Used when the document has no Company field. Leave blank to skip the company level for such documents."
  },
  {
   "depends_on": "eval: doc.enable_file_sync == 1 && doc.folder_structure != 'Flat'",
   "fieldname": "doctype_folders",
   "fieldtype": "Table",
   "label": "Document Type Folders",
   "options": "SharePoint DocType Folder",
   "description": "Name of the second-level folder per document type, e.g., Expense Claim -> Expenses. Document types not listed here use their module name."
  }
